{
  "version": 2,
  "installCommand": "npm install && npm install --prefix attendance-frontend",
  "buildCommand": "npm run build --prefix attendance-frontend",
  "outputDirectory": "attendance-frontend/dist",
  "functions": {
    "api/index.js": {
      "includeFiles": "server/**"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.js" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
